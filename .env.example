# AI Product Catalogue Generator Environment Variables

# Google Gemini API Key (for image/text generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3002

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# JWT Secret for authentication (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
