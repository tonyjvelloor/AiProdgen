# Required database and authentication settings. Use separate staging values for tests.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
# 64 hex characters. Preserve the existing value if keys are already encrypted.
KEY_ENCRYPTION_SECRET=
APP_URL=https://www.aiprodgen.online
PORT=3002

# Optional platform-funded generation. Customer Gemini keys are saved in the encrypted vault.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_TEXT_MODEL=gemini-3.8-flash
REPLICATE_API_TOKEN=
PLATFORM_SPEND_CEILING_USD=25

# Razorpay: set a real webhook secret in both the dashboard and deployment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Verification and password-reset email: configure Resend OR SMTP.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Require distributed limiting on production deployments after Redis is configured.
RATELIMIT_REQUIRED=false
SENTRY_DSN=
FB_ACCESS_TOKEN=
FB_PIXEL_ID=

# npm run test:integration uses TEST_ prefixed credentials only; never production credentials.
# TEST_SUPABASE_URL=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
# TEST_JWT_SECRET=
# TEST_RAZORPAY_KEY_SECRET=
# TEST_RAZORPAY_WEBHOOK_SECRET=
